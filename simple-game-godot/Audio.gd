extends Node
## Music and sound effects. Each scene has its own track (see SCENE_MUSIC; levels pick theirs by region,
## so random maps sound like the region they're laid out as), crossfaded on every change. Sounds play
## through a small pool of voices on the SFX bus, so a volley of arrows can't flood the mixer. Both buses'
## volumes are player settings, saved on their own so they apply to every character.
##
## The tracks and sounds in res://audio are generated by res://tools/generate_audio.gd.

const SETTINGS_PATH := "user://audio_settings.cfg"
const MUSIC_BUS := &"Music"
const SFX_BUS := &"SFX"
const DEFAULT_MUSIC_VOLUME := 0.7
const DEFAULT_SFX_VOLUME := 0.85
const MUSIC_DIR := "res://audio/music/"
const SFX_DIR := "res://audio/sfx/"
const MUSIC_FADE_TIME := 1.2
const LOADING_MUSIC := "loading"
const BOSS_MUSIC := "boss"
const SCENE_MUSIC := {
	"res://Menu.tscn": "title",
	"res://town.tscn": "oblath",
	"res://desert_camp.tscn": "saltwind",
	"res://ice_settlement.tscn": "rimehollow",
	"res://besieged_outpost.tscn": "ashgate",
	"res://main.tscn": "forest",
	"res://desert.tscn": "desert",
	"res://ice_caves.tscn": "ice_caves",
	"res://underworld.tscn": "underworld",
}
## LevelController biomes (forest, desert, ice, underworld) to their region's track.
const BIOME_MUSIC: Array[String] = ["forest", "desert", "ice_caves", "underworld"]

const SFX_VOICES := 16
## The same sound won't restart sooner than this, nor play on more than SFX_MAX_SAME voices at once.
const SFX_MIN_GAP_MSEC := 45
const SFX_MAX_SAME := 3
## Longer gaps for sounds that fire in bursts (damage ticks, many monsters hitting at once).
const SFX_GAPS_MSEC := {"enemy_attack": 110, "player_hurt": 140, "enemy_hit": 55, "dodge": 120}
## Sounds placed in the world are full volume near the middle of the screen, fade with distance and
## aren't played at all past SFX_SILENT_DISTANCE.
const SFX_FULL_VOLUME_DISTANCE := 420.0
const SFX_SILENT_DISTANCE := 1100.0

var music_volume := DEFAULT_MUSIC_VOLUME
var sfx_volume := DEFAULT_SFX_VOLUME
## The track playing (or fading in), "" for silence.
var current_music := ""

var _music_players: Array[AudioStreamPlayer] = []
var _music_tweens: Array[Tween] = [null, null]
var _active_music := 0
## The loading track carries on from where it was left, so back-to-back loading screens don't keep
## replaying its first bars.
var _loading_position := 0.0
var _sfx_streams: Dictionary[String, AudioStream] = {}
var _sfx_players: Array[AudioStreamPlayer] = []
var _sfx_playing: Array[String] = []
var _sfx_last_played: Dictionary[String, int] = {}
var _next_voice := 0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_bus(MUSIC_BUS)
	_ensure_bus(SFX_BUS)
	for index in 2:
		var player := AudioStreamPlayer.new()
		player.bus = MUSIC_BUS
		add_child(player)
		_music_players.append(player)
	for index in SFX_VOICES:
		var player := AudioStreamPlayer.new()
		player.bus = SFX_BUS
		add_child(player)
		_sfx_players.append(player)
		_sfx_playing.append("")
	_load_sounds()
	_load_settings()
	get_tree().node_added.connect(_on_node_added)
	GameState.player_leveled_up.connect(func(_level: int) -> void: play_sfx("level_up"))
	_play_startup_music.call_deferred()


func _play_startup_music() -> void:
	var scene := get_tree().current_scene
	if scene != null:
		play_scene_music(scene.scene_file_path)


# --- Music ------------------------------------------------------------------------------------------


## Crossfades to `track` (a file name in res://audio/music, "" for silence). Asking for the track
## already playing does nothing, so it carries on uninterrupted.
func play_music(track: String, fade := MUSIC_FADE_TIME) -> void:
	if track == current_music:
		return
	var outgoing := _music_players[_active_music]
	if current_music == LOADING_MUSIC and outgoing.playing:
		_loading_position = outgoing.get_playback_position()
	current_music = track
	_fade_music(_active_music, 0.0, fade)
	if track.is_empty():
		return
	var stream := load(MUSIC_DIR + track + ".wav") as AudioStream
	if stream == null:
		push_warning("Missing music track: %s" % track)
		return
	_active_music = 1 - _active_music
	var player := _music_players[_active_music]
	player.stream = stream
	player.volume_linear = 0.0
	var start := 0.0
	if track == LOADING_MUSIC:
		start = fmod(_loading_position, maxf(stream.get_length(), 0.01))
	player.play(start)
	_fade_music(_active_music, 1.0, fade)


func stop_music(fade := MUSIC_FADE_TIME) -> void:
	play_music("", fade)


## The track for a scene, if it has a fixed one. Levels set theirs from their region when they load.
func play_scene_music(scene_path: String) -> void:
	if SCENE_MUSIC.has(scene_path):
		play_music(SCENE_MUSIC[scene_path])


func play_region_music(biome: int) -> void:
	if biome >= 0 and biome < BIOME_MUSIC.size():
		play_music(BIOME_MUSIC[biome])


func _fade_music(index: int, target: float, duration: float) -> void:
	var player := _music_players[index]
	if _music_tweens[index] != null and _music_tweens[index].is_valid():
		_music_tweens[index].kill()
	var tween := create_tween()
	tween.tween_property(player, "volume_linear", target, duration)
	if target <= 0.0:
		tween.tween_callback(player.stop)
	_music_tweens[index] = tween


# --- Sound effects ----------------------------------------------------------------------------------


## Plays a sound from res://audio/sfx at full volume (plus `volume_db`), slightly varying its pitch so
## repeats don't sound mechanical.
func play_sfx(sfx_name: String, volume_db := 0.0, pitch_variation := 0.05) -> void:
	var stream: AudioStream = _sfx_streams.get(sfx_name)
	if stream == null:
		push_warning("Missing sound effect: %s" % sfx_name)
		return
	var now := Time.get_ticks_msec()
	var gap: int = SFX_GAPS_MSEC.get(sfx_name, SFX_MIN_GAP_MSEC)
	if now - _sfx_last_played.get(sfx_name, -100000) < gap:
		return
	var same := 0
	for index in SFX_VOICES:
		if _sfx_players[index].playing and _sfx_playing[index] == sfx_name:
			same += 1
	if same >= SFX_MAX_SAME:
		return
	_sfx_last_played[sfx_name] = now
	var voice := _take_voice()
	var player := _sfx_players[voice]
	player.stream = stream
	player.volume_db = volume_db
	player.pitch_scale = 1.0 + randf_range(-pitch_variation, pitch_variation)
	player.play()
	_sfx_playing[voice] = sfx_name


## Plays a sound that happens somewhere in the world: quieter the further it is from the middle of the
## screen, and skipped entirely when it's well off screen.
func play_sfx_at(sfx_name: String, world_position: Vector2, volume_db := 0.0) -> void:
	var viewport := get_viewport()
	var screen_center := viewport.get_canvas_transform().affine_inverse() * (viewport.get_visible_rect().size * 0.5)
	var camera := viewport.get_camera_2d()
	if camera != null:
		screen_center = camera.get_screen_center_position()
	var distance := screen_center.distance_to(world_position)
	if distance >= SFX_SILENT_DISTANCE:
		return
	var falloff := clampf(
		1.0 - (distance - SFX_FULL_VOLUME_DISTANCE) / (SFX_SILENT_DISTANCE - SFX_FULL_VOLUME_DISTANCE), 0.05, 1.0
	)
	play_sfx(sfx_name, volume_db + linear_to_db(falloff))


## Cuts a sound short (e.g. a channel that was interrupted).
func stop_sfx(sfx_name: String) -> void:
	for index in SFX_VOICES:
		if _sfx_playing[index] == sfx_name:
			_sfx_players[index].stop()
			_sfx_playing[index] = ""


## A free voice, or else the one that started longest ago.
func _take_voice() -> int:
	for offset in SFX_VOICES:
		var index := (_next_voice + offset) % SFX_VOICES
		if not _sfx_players[index].playing:
			_next_voice = (index + 1) % SFX_VOICES
			return index
	var oldest := _next_voice
	_next_voice = (_next_voice + 1) % SFX_VOICES
	return oldest


## Loads every sound up front (they're small), so the first swing doesn't stall on a disk read.
func _load_sounds() -> void:
	for file_name in ResourceLoader.list_directory(SFX_DIR):
		if not file_name.ends_with(".wav"):
			continue
		var stream := load(SFX_DIR + file_name) as AudioStream
		if stream != null:
			_sfx_streams[file_name.get_basename()] = stream


## Every button in every menu clicks. The on-screen combat controls stay quiet: they fire skills, which
## have their own sounds.
func _on_node_added(node: Node) -> void:
	if not node is BaseButton:
		return
	var ancestor := node.get_parent()
	while ancestor != null:
		if ancestor is TouchControls:
			return
		ancestor = ancestor.get_parent()
	(node as BaseButton).pressed.connect(play_sfx.bind("ui_click"))


# --- Settings ---------------------------------------------------------------------------------------


func set_music_volume(value: float) -> void:
	music_volume = clampf(value, 0.0, 1.0)
	_apply_bus_volume(MUSIC_BUS, music_volume)
	_save_settings()


func set_sfx_volume(value: float) -> void:
	sfx_volume = clampf(value, 0.0, 1.0)
	_apply_bus_volume(SFX_BUS, sfx_volume)
	_save_settings()


func _apply_bus_volume(bus_name: StringName, value: float) -> void:
	var index := AudioServer.get_bus_index(bus_name)
	AudioServer.set_bus_mute(index, value <= 0.001)
	# Squared, so the slider's middle sounds like half volume rather than barely quieter.
	AudioServer.set_bus_volume_db(index, linear_to_db(maxf(value * value, 0.0001)))


func _ensure_bus(bus_name: StringName) -> void:
	if AudioServer.get_bus_index(bus_name) != -1:
		return
	AudioServer.add_bus()
	var index := AudioServer.bus_count - 1
	AudioServer.set_bus_name(index, bus_name)
	AudioServer.set_bus_send(index, &"Master")


func _load_settings() -> void:
	var config := ConfigFile.new()
	if config.load(SETTINGS_PATH) == OK:
		music_volume = clampf(float(config.get_value("audio", "music_volume", DEFAULT_MUSIC_VOLUME)), 0.0, 1.0)
		sfx_volume = clampf(float(config.get_value("audio", "sfx_volume", DEFAULT_SFX_VOLUME)), 0.0, 1.0)
	_apply_bus_volume(MUSIC_BUS, music_volume)
	_apply_bus_volume(SFX_BUS, sfx_volume)


func _save_settings() -> void:
	var config := ConfigFile.new()
	config.set_value("audio", "music_volume", music_volume)
	config.set_value("audio", "sfx_volume", sfx_volume)
	if config.save(SETTINGS_PATH) != OK:
		push_warning("Could not save audio settings.")
